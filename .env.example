# Copy to .env and fill in. Never commit .env.
# The app runs fully without any of these: AI falls back to a labelled "Demo response" provider.

# Gemini (server only). Leave blank to use the mock provider.
GEMINI_API_KEY=
# Exact model name from Google AI Studio docs. Do not guess. Leave blank to use the mock provider.
GEMINI_MODEL=

# Camera story mode: minimum confidence (0..1) before a place match is shown.
MATCH_THRESHOLD=0.85

# Demo mode shows sample content (always badged "Sample content"). Set false for real content only. Rebuild after changing.
NEXT_PUBLIC_DEMO_MODE=true

# Upload timeout in ms (voice onboarding / camera). A slow-network message appears after this.
UPLOAD_TIMEOUT_MS=45000

# Where SQLite and uploaded files live (gitignored).
MIRAS_DATA_DIR=./data

# Passcode for /admin/moderation (visitor "Hidden Udaipur" picks). Leave blank to keep moderation disabled.
ADMIN_PASSCODE=

# Set true ONLY behind a trusted proxy (cloudflared or ngrok tunnel). Then the rate limiter keys on cf-connecting-ip or the last
# x-forwarded-for hop. Leave false otherwise: forwarded headers can be forged by any client.
TRUST_PROXY=false
# Optional ceilings for ALL visitors together (defaults: camera 120 per minute, onboarding drafts 60 and memories 60 per 10 minutes).
# RATE_GLOBAL_CAMERA=120
# RATE_GLOBAL_ONBOARD_DRAFT=60
# RATE_GLOBAL_MEMORIES=60

# Per-call timeout for Gemini, in ms (default 25000). One retry happens on 429 and 5xx only. Check the setup with: npm run ai:check
# GEMINI_TIMEOUT_MS=25000
