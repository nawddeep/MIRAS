{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/hero.js", "src/main.js", "src/art.js"]
}
